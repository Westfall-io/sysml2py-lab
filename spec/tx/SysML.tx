UsageElement:
	NonOccurrenceUsageElement | OccurrenceUsageElement
;
SpecializesKeyword:
	:> | specializes
;
OwnedSubclassification:
	superclassifier=[SysML::Classifier|QualifiedName]
;
DefinedByKeyword:
	: | defined by
;
SubsetsKeyword:
	:> | subsets
;
ReferencesKeyword:
	::> | references
;
RedefinesKeyword:
	:>> | redefines
;
FeatureTyping:
	OwnedFeatureTyping | ConjugatedPortTyping
;
OwnedSubsetting:
	subsettedFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
OwnedReferenceSubsetting:
	referencedFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
OwnedRedefinition:
	redefinedFeature=[SysML::Feature|QualifiedName] | ownedRelatedElement+=OwnedFeatureChain
;
OwnedMultiplicity:
	ownedRelatedElement+=MultiplicityRange
;
MultiplicityRange:
	[ ownedRelationship+=MultiplicityExpressionMember (.. ownedRelationship+=MultiplicityExpressionMember)? ]
;
MultiplicityExpressionMember:
	ownedRelatedElement+=(LiteralExpression | FeatureReferenceExpression)
;
DefinitionMember:
	(visibility=VisibilityIndicator)? ownedRelatedElement+=DefinitionElement
;
VariantUsageMember:
	(visibility=VisibilityIndicator)? variant ownedRelatedElement+=VariantUsageElement
;
NonOccurrenceUsageMember:
	(visibility=VisibilityIndicator)? ownedRelatedElement+=NonOccurrenceUsageElement
;
OccurrenceUsageMember:
	(visibility=VisibilityIndicator)? ownedRelatedElement+=OccurrenceUsageElement
;
StructureUsageMember:
	(visibility=VisibilityIndicator)? ownedRelatedElement+=StructureUsageElement
;
BehaviorUsageMember:
	(visibility=VisibilityIndicator)? ownedRelatedElement+=BehaviorUsageElement
;
FeatureDirection:
	in = in | out = out | inout = inout
;
FeatureValue:
	(= | isDefault?=default (= | isInitial?=:=)?) ownedRelatedElement+=OwnedExpression
;
FeatureValueExpression:
	isInitial?=:= ownedRelatedElement+=OwnedExpression
;
EmptyAssignmentActionMember:
	ownedRelatedElement+=EmptyAssignmentAction
;
EmptyAssignmentAction:
	ownedRelationship+=EmptyTargetMember ownedRelationship+=EmptyParameterMember
;
EmptyTargetMember:
	ownedRelatedElement+=EmptyTargetParameter
;
EmptyTargetParameter:
	ownedRelationship+=TargetFeatureMember
;
