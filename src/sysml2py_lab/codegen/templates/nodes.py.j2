from __future__ import annotations

from dataclasses import dataclass, field
from typing import Iterable, Union

from .normalize import normalize_text


@dataclass
class Node:
    """Base node class."""

    def dump(self) -> str:
        """Return SysML text for this node (normalized)."""
        raise NotImplementedError


@dataclass
class Statement(Node):
    """
    Generic statement line.

    Example:
      Statement("attribute mass;")
    """

    text: str

    def dump(self) -> str:
        return normalize_text(self.text)


Child = Union["Statement", "Block"]


@dataclass
class Block(Node):
    """
    A brace-delimited block.

    header: optional header line (e.g., "part sensor")
    children: statements and nested blocks
    """

    header: str = ""
    children: list[Child] = field(default_factory=list)

    def add(self, child: Child) -> "Block":
        self.children.append(child)
        return self

    def dump(self) -> str:
        lines: list[str] = []
        if self.header:
            lines.append(self.header.strip() + " {")
        else:
            lines.append("{")

        for c in self.children:
            txt = c.dump().strip()
            if txt:
                # indent children one level (MVP)
                for ln in txt.splitlines():
                    lines.append("  " + ln)

        lines.append("}")
        return "\n".join(lines) + "\n"


@dataclass
class Document(Node):
    """Top-level container (list of statements/blocks)."""

    children: list[Child] = field(default_factory=list)

    def add(self, child: Child) -> "Document":
        self.children.append(child)
        return self

    def dump(self) -> str:
        parts: list[str] = []
        for c in self.children:
            parts.append(c.dump())
        return normalize_text("\n".join(parts))
