[build-system]
requires = ["hatchling>=1.24.0"]
build-backend = "hatchling.build"

[project]
name = "sysml2py"
version = "{{ version }}"
description = "Autogenerated SysML v2 builder library (generated by sysml2py-lab)."
readme = "README.md"
requires-python = ">=3.10"
authors = [{ name = "Westfall-io" }]
license = { text = "MIT" }

dependencies = []

[project.optional-dependencies]
dev = [
  "pytest>=7.4",
]

[tool.hatch.build]
packages = ["src/sysml2py"]
