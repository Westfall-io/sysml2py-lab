{{ header }}
"""Generated builder API for the sysml2py AST (issue #10, phase-5).

Deterministically generated by sysml2py-lab from:
  - spec/relationships/modifiers.json  (per-kind modifier setters)
  - spec/relationships/children.json   (advisory child-kind legality)
  - IR_KIND_ALIASES / node kinds       (which builder classes to emit)

This is a SELF-CONTAINED, THIN builder: it targets the canonical IR dict
shape (the same shape ``ast_classes.Node.from_ir`` consumes), so a model
built through this API casts — ``build()`` -> ``Node`` -> ``get_definition()``
preserves the authored content.  It deliberately does NOT require textX or
astropy at runtime (issue #10 dependency-posture decision: self-contained
thin; see the API-compat report for the 0.5.3 breaks this entails).
"""

from __future__ import annotations

from .ast_classes import Node

# ruff: noqa: RUF022  (generated __all__ ordering)

__all__ = [
    "Builder",
    "LEGAL_CHILDREN",
{% for name in builder_class_names %}
    "{{ name }}",
{% endfor %}
]

# Which child kinds MAY live under each owning body, derived from children.json.
# This is ADVISORY metadata (B2): _set_child does not hard-reject, because the
# usage-body child data is not yet load-bearing (UsageBody has no slots in
# children.json).  `is_legal_child()` on Builder consults this table where it
# IS populated (PackageBody / DefinitionBody).
LEGAL_CHILDREN: dict[str, set[str]] = {
{% for body, kinds in legal_children.items() %}
    "{{ body }}": {
{% for k in kinds %}
        "{{ k }}",
{% endfor %}
    },
{% endfor %}
}



class Builder:
    """Base builder: accumulates a canonical-IR dict sub-tree.

    ``build()`` returns the IR dict, ``build_node()`` lifts it through
    ``Node.from_ir``, and ``dump()`` renders textual SysML via the syntactic
    ``_render_sysml`` emitter (which the lab's ``parse_ir`` recovers).
    """

    kind = ""
    ir_kind = ""  # coarse canonical-IR kind (W1-3); set per builder class
    owned_body = None  # e.g. "PackageBody" — advisory legal-child body
    _is_definition = False

    def __init__(self, name=None, *, kind=None):
        self._name = name
        self._short_name = None
        self._text = None
        self._modifiers: dict[str, object] = {}
        self._typed_by = None
        self._kind = kind or self.ir_kind  # coarse canonical-IR kind (W1-3)
        self._children: list[Builder] = []

    # -- identity -------------------------------------------------------

    def _set_name(self, name, short=False):
        if short:
            self._short_name = name
        else:
            self._name = name
        return self

    def _get_name(self):
        return self._short_name or self._name

    def _set_short_name(self, name):
        self._short_name = name
        return self

    def _set_text(self, text):
        """Set a free-text payload (W2-8; meaningful for Comment)."""
        self._text = text
        return self

    # -- modifiers ------------------------------------------------------

{% for slot in usage_modifier_slots %}
    def _set_{{ slot.name }}(self, value=None):
        """Set the ``{{ slot.tokens|join(' ') }}`` modifier(s)."""
{% if slot.kind == 'flag' %}
        self._modifiers["{{ slot.tokens[0] }}"] = True if value is None else value
{% else %}
        self._modifiers["{{ slot.tokens[0] }}"] = value
{% endif %}
        return self
{% endfor %}

    # -- typing ---------------------------------------------------------

    def _set_typed_by(self, typed):
        if not isinstance(typed, Builder):
            raise TypeError("_set_typed_by expects a Builder")
        if self._is_definition:
            raise ValueError("A definition element cannot be typed.")
        self._typed_by = typed
        return self

    # -- children -------------------------------------------------------

    def _set_child(self, child):
        if not isinstance(child, Builder):
            raise TypeError("_set_child expects a Builder")
        self._children.append(child)
        return self

    def is_legal_child(self, child):
        """Advisory child-kind legality (W1-5).  True when LEGAL_CHILDREN has
        data for this builder's owned body and the child's kind is absent from
        it; otherwise conservatively True (the table is not load-bearing)."""
        if self.owned_body in LEGAL_CHILDREN:
            allowed = LEGAL_CHILDREN[self.owned_body]
            if child.kind not in allowed:
                return False
        return True

    def _get_child(self, featurechain):
        return _walk_chain(self, featurechain)

    # -- directed features ----------------------------------------------

    def add_directed_feature(self, direction, name=None, *, kind_name="DefaultReferenceUsage"):
        if direction not in ("in", "out", "inout"):
            raise ValueError(f"direction must be in/out/inout, got {direction!r}")
        cls = _BUILDER_BY_NAME.get(kind_name, _DefaultReferenceBuilder)
        feat = cls(name)
        feat._set_direction(direction)
        self._set_child(feat)
        return self

    def _get_grammar(self):
        return self.build_node()

    def build(self, dict_=True):
        d = self._to_ir()
        return d if dict_ else self.build_node()

    def build_node(self):
        return Node.from_ir(self._to_ir())

    def dump(self):
        from .ast_classes import beautify
        text = self._render_sysml()
        return beautify(text) if text.strip() else text

    def _render_sysml(self) -> str:
        """Render this builder subtree as textual SysML.

        Emits a ``KIND name`` header (modifiers upstream) and ``{ child ... }
        `` body braces.  Uses the coarse canonical-IR kind + grammar modifier
        tokens (W1-3) so the header vocabulary matches ``parse_ir``.  Omits
        ``;`` terminators — the brace structure is what the coarse ``parse_ir``
        recovers.
        """
        mods: list[str] = []
        for k, v in self._modifiers.items():
            if v is True:
                mods.append(k)
            elif v is None or v is False:
                continue
            elif isinstance(v, str):
                mods.append(v)  # enum — bare value (W1-3)
            else:
                mods.append(f"{k}={v}")
        mod_txt = (" ".join(mods) + " ") if mods else ""
        kind = self._kind or self.__class__.__name__.replace("Builder", "")
        head = f"{mod_txt}{kind}"
        if self._name is not None:
            head += f" {self._name}"
        if self._typed_by is not None:
            # W2-5: render ":" (typing), not ":>" (specialization); use the
            # referent's _name (long name), which matches the name IR field.
            head += f" : {self._typed_by._name}"
        lines = [head]
        kids = [c for c in self._children if c is not None]
        if kids:
            lines.append("{")
            for c in kids:
                lines.append(c._render_sysml())
            lines.append("}")
        return "\n".join(lines)

    def _to_ir(self):
        d: dict[str, object] = {"kind": self._kind}
        if self._name is not None:
            d["name"] = self._name
        if self._short_name is not None:
            d["short_name"] = self._short_name
        if self._text is not None:
            d["raw_text"] = self._text
        mods: list[str] = []
        for k, v in self._modifiers.items():
            if v is True:
                mods.append(k)
            elif v is None or v is False:
                continue
            elif isinstance(v, str):
                mods.append(v)  # enum — bare value (W1-3)
            else:
                mods.append(f"{k}={v}")
        if mods:
            d["modifiers"] = mods
        if self._typed_by is not None:
            # B1/W2-5: type_refs is the _NODE_IR_FIELDS key that carries the
            # typed reference (typed_by was never in the AST IR and would
            # throw).  Use the referent's _name to match the name IR field.
            d["type_refs"] = [self._typed_by._name]
        kids = [c for c in self._children if c is not None]
        if kids:
            d["children"] = [c._to_ir() for c in kids]
        return d


class _DefaultReferenceBuilder(Builder):
    kind = "DefaultReferenceUsage"
    ir_kind = "reference"
    owned_body = None


def _walk_chain(root, featurechain):
    """Resolve a dotted feature chain ('x.y.z') under ``root``.

    A leading self-name segment (matched against the root's effective name)
    is tolerated (0.5.3 _get_child behaviour) and skipped.
    """
    if not isinstance(featurechain, str):
        raise TypeError("featurechain must be a str")
    fc = featurechain.split(".")
    if fc and root._get_name() == fc[0]:
        fc = fc[1:]
        if not fc:
            return root
    cur = root
    for seg in fc:
        found = None
        for child in cur._children:
            if child._get_name() == seg:
                found = child
                break
        if found is None:
            return None
        cur = found
    return cur


{% for cls in builder_classes %}
class {{ cls.name }}(Builder):
    """Builder for a {{ cls.kind }} (IR kind: {{ cls.ir_kind }})."""
{% if cls.is_definition %}
    _is_definition = True
{% endif %}
    kind = "{{ cls.kind }}"
    ir_kind = "{{ cls.ir_kind }}"
    owned_body = {{ cls.owned_body_lit }}

{% endfor %}

# node-kind name -> builder class (for add_directed_feature's kind_name lookup).
# Keyed by the *node-kind* name (e.g. "PartUsage") so kind_name works.
_BUILDER_BY_NAME: dict[str, type[Builder]] = {
{% for cls in builder_classes %}
    "{{ cls.kind }}": {{ cls.name }},
{% endfor %}
}
