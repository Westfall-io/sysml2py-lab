"""Generated builder API for the sysml2py AST (issue #10, phase-5).

Deterministically generated by sysml2py-lab from:
  - spec/relationships/modifiers.json  (per-kind modifier setters)
  - spec/relationships/children.json   (advisory child-kind legality)
  - IR_KIND_ALIASES / node kinds       (which builder classes to emit)

This is a SELF-CONTAINED, THIN builder: it targets the canonical IR dict
shape (the same shape ``ast_classes.Node.from_ir`` consumes), so a model
built through this API casts — ``build()`` -> ``Node`` -> ``get_definition()``
preserves the authored content.  It deliberately does NOT require textX or
astropy at runtime (issue #10 dependency-posture decision: self-contained
thin; see the API-compat report for the 0.5.3 breaks this entails).
"""

from __future__ import annotations

from .ast_classes import Node

# ruff: noqa: RUF022  (generated __all__ ordering)

__all__ = [
    "Builder",
    "LEGAL_CHILDREN",
{% for name in builder_class_names %}
    "{{ name }}",
{% endfor %}
{% for name in friendly_class_names %}
    "{{ name }}",
{% endfor %}
]

# Which child kinds MAY live under each owning body, derived from children.json.
# This is ADVISORY metadata (B2): _set_child does not hard-reject, because the
# usage-body child data is not yet load-bearing (UsageBody has no slots in
# children.json).  `is_legal_child()` on Builder consults this table where it
# IS populated (PackageBody / DefinitionBody).
LEGAL_CHILDREN: dict[str, set[str]] = {
{% for body, kinds in legal_children.items() %}
    "{{ body }}": {
{% for k in kinds %}
        "{{ k }}",
{% endfor %}
    },
{% endfor %}
}



# Canonical modifier-slot order (from modifiers.json BasicUsagePrefix).  Used
# for slot-order emission (r2 W1-3 / r3 W2-10) and enum validation, so a
# published list can't drift from the setter generation.
_MODIFIER_SLOTS: list[tuple[str, tuple[str, ...], str]] = [
{% for slot in usage_modifier_slots %}
    ("{{ slot.name }}", {{ slot.tokens|list }}, "{{ slot.kind }}"),
{% endfor %}
]

# IR kind -> printable SysML keyword forms (issue #27, W1-A/W2-C single
# source).  Generated from the model's IR_KIND_ALIASES so the builder's
# accepted kinds and the node's printed keywords can never drift.  For each
# builder ir_kind: (usage keyword, def keyword-or-None).  Module-level so
# generated subclasses stay immutable (ruff RUF012) and the friendly `kind=`
# normalizer has ONE source of truth for what it accepts + prints.
_IR_KEYWORD: dict[str, tuple[str, ...]] = {
{% for ir, usage_kw, def_kw in ir_keywords %}
{% if def_kw %}
    "{{ ir }}": ("{{ usage_kw }}", "{{ def_kw }}"),
{% else %}
    "{{ ir }}": ("{{ usage_kw }}",),
{% endif %}
{% endfor %}
}

# Issue #26: astropy base-unit name -> SysML namespace.  Option A = import
# exactly the unit actually used (`public import SI::kg;`), never a wildcard.
# Fail-loud: a unit NOT in this map raises NotImplemented so a value= quantity
# can never emit a silently-wrong model.  Keys are astropy's canonical base
# names (``unit.bases`` strings), values are the SysML namespace owning them.
# Composite units (``m/s2``) decompose to their bases; each distinct base
# contributes one import in its own namespace.
_UNIT_NAMESPACE: dict[str, str] = {
    # SI base + derived (corpus already uses `public import SI::kg;`)
    "kg": "SI", "m": "SI", "s": "SI", "km": "SI", "l": "SI", "L": "SI",
    "h": "SI", "N": "SI", "Pa": "SI", "J": "SI", "W": "SI", "V": "SI",
    "A": "SI", "K": "SI", "mol": "SI", "cd": "SI", "rad": "SI", "sr": "SI",
    "Hz": "SI", "C": "SI", "F": "SI", "Ohm": "SI", "S": "SI", "T": "SI",
    "H": "SI", "lm": "SI", "lx": "SI", "Bq": "SI", "Gy": "SI", "Sv": "SI",
    "kat": "SI", "%": "SI",
    # non-SI length/volume/common
    "mi": "USCustomaryUnits", "ft": "USCustomaryUnits",
    "in": "USCustomaryUnits", "yd": "USCustomaryUnits",
    "gallon": "USCustomaryUnits", "gal": "USCustomaryUnits",
    "lb": "USCustomaryUnits", "oz": "USCustomaryUnits",
    "ton": "USCustomaryUnits", "mph": "USCustomaryUnits",
    "min": "SI", "ms": "SI", "us": "SI", "ns": "SI", "day": "SI",
    "g": "SI", "t": "SI",
}


class Builder:
    """Base builder: accumulates a canonical-IR dict sub-tree.

    ``build()`` returns the IR dict, ``build_node()`` lifts it through
    ``Node.from_ir``, and ``dump()`` renders textual SysML via the syntactic
    ``_render_sysml`` emitter (which the lab's ``parse_ir`` recovers).
    """

    kind = ""
    ir_kind = ""  # coarse canonical-IR kind (W1-3); set per builder class
    owned_body = None  # e.g. "PackageBody" — advisory legal-child body
    _is_definition = False

    def __init__(self, name=None, *, kind=None, value=None, unit=None):
        self._name = name
        self._short_name = None
        self._text = None
        self._multiplicity = None
        # Issue #26: `value=` may be a plain scalar/string OR an astropy
        # Quantity (duck-typed).  Coerce the value to its IR string; if the
        # input was a Quantity, auto-derive `_unit` from it (unless the
        # caller passed an explicit `unit=` override).
        self._value, _qunit = self._coerce_value(value)
        self._unit = unit if (unit is not None) else _qunit
        self._modifiers: dict[str, object] = {}
        self._typed_by = None
        # Issue #27: separate TWO roles the old code conflated (review W1-3):
        #   - `self._kind`    : the IR ALIAS key (used by `_to_ir()` for the
        #                       round-trip cast; MUST be an IR_KIND_ALIASES
        #                       key, e.g. "part", "part def", "use_case").
        #   - `self._keyword` : the printable SysML keyword (used by
        #                       `_render_sysml()`, e.g. "part", "part def",
        #                       "use case").  Conflating them made
        #                       `UseCase('S')` print `use_case S;` (invalid).
        # kind= accepts friendly values (usage/definition), the SysML keyword
        # form ("part def"), or the IR kind ("part").  Class-name forms
        # ("PartDefinition") are REJECTED.
        ir = self.ir_kind
        # W2-D: base `Builder` is abstract; reject bare construction.
        if not ir:
            raise TypeError(
                f"{self.__class__.__name__} is abstract; use a generated "
                f"subclass (e.g. Part, Attribute)"
            )
        kw = _IR_KEYWORD[ir]  # strict: a kind the generator forgot -> KeyError
        usage_kw = kw[0]
        def_kw = kw[1] if len(kw) > 1 else None
        # Accept BOTH the IR (underscore) and printable (space) keyword forms
        # for `kind=` (W2-E): 'part'/'use_case' == usage; 'part def'/
        # 'use_case def'/'use case def' == definition.
        _ir_def = f"{ir} def"
        if kind is None or kind == "usage" or kind in (ir, usage_kw):
            self._kind = ir
            self._keyword = usage_kw
        elif kind in ("definition", "def") or kind in (_ir_def, def_kw):
            if def_kw is None:
                raise ValueError(
                    f"{self.__class__.__name__} has no definition form "
                    f"(kind={kind!r})"
                )
            self._kind = _ir_def
            self._keyword = def_kw
            self._is_definition = True  # W2-5: honest introspection + typing guard
        else:
            raise ValueError(
                f"kind={kind!r} not valid for {self.__class__.__name__}; "
                f"use 'usage'|'definition'"
            )
        self._children: list[Builder] = []

    # -- identity -------------------------------------------------------

    def _set_name(self, name, short=False):
        if short:
            self._short_name = name
        else:
            self._name = name
        return self

    def _get_name(self):
        return self._short_name or self._name

    def _set_short_name(self, name):
        self._short_name = name
        return self

    def _set_text(self, text):
        """Set a free-text payload (r2 W2-8; meaningful ONLY for Comment).

        r6 W2-1: text has an IR home (``raw_text``) only for Comment; on any
        other kind there is no IR field that carries it, so setting it would
        silently vanish from ``build()``/``get_definition()`` while showing in
        ``dump()``.  Refuse rather than emit content that cannot be cast.
        """
        if self._kind != "comment":
            raise TypeError(
                f"_set_text is only supported on Comment builders "
                f"(got kind {self._kind!r}; text has no IR field on this kind)"
            )
        self._text = text
        return self

    # -- value (issue #26) ---------------------------------------------

    @staticmethod
    def _coerce_value(value):
        """Normalize a ``value=`` into ``(ir_value_str, unit_or_None)``.

        ``None``/``""`` -> ``(None, None)`` (no value).  A plain ``str``/
        ``int``/``float`` is taken literally (no unit; a numeric float is
        rendered without a trailing ``.0``).  An astropy ``Quantity``
        (duck-typed: has ``.value`` and ``.unit``) yields its numeric
        ``.value`` together with ``.unit.to_string()`` for the ``[unit]``
        bracket and the auto-import.  Anything else raises ``TypeError``
        (fail fast — the value must be representable in the IR or it cannot
        cast).
        """
        if value is None or value == "":
            return None, None
        if isinstance(value, str):
            return value, None
        if isinstance(value, bool):
            return str(value), None
        if isinstance(value, (int, float)):
            return str(value).removesuffix(".0"), None
        # duck-typed astropy Quantity: a numeric value with a unit attribute
        if hasattr(value, "value") and hasattr(value, "unit"):
            u = value.unit.to_string()
            return str(value.value).removesuffix(".0"), u
        raise TypeError(
            f"value= must be str/int/float or an astropy Quantity, got "
            f"{type(value).__name__}"
        )

    @staticmethod
    def _unit_to_namespace(unit_name: str) -> str:
        """Map an astropy unit base-name to its SysML namespace (issue #26,
        Option A, fail-loud).  Raise ValueError for unmapped units so a
        value= quantity can never generate a silently-wrong model.  (ValueError
        — not NotImplementedError — to preserve the parser-lossless
        zero-NotImplemented acceptance invariant, issue #9: unsupported
        *parser* constructs are preserved, never raised.)"""
        _ns = _UNIT_NAMESPACE
        ns = _ns.get(unit_name)
        if ns is None:
            raise ValueError(
                f"unit {unit_name!r} is not in the built-in unit map "
                f"(issue #26); add it to _UNIT_NAMESPACE or use a plain "
                f"string value with no unit"
            )
        return ns

    @staticmethod
    def _unit_bracket(unit_name: str) -> str:
        """Normalize an astropy composite unit string into the SysML bracket
        spelling (no spaces): ``'m / s2'`` -> ``'m/s2'``."""
        return "".join(unit_name.split())

    def _unit_imports(self) -> list[str]:
        """The (namespace, unit-base) imports this node requires (issue #26,
        Option A).  Returns ``[(\"SI\", \"kg\"), ...]`` for each unit
        referenced by this node's own ``unit=`` (decomposed to its bases).
        Empty when no unit is set.
        """
        if not self._unit:
            return []
        # The unit may be composite ('m / s2'); decompose into its bases so
        # each contributes one import (Option A = only what's needed).  The
        # stored `_unit` is a normalized string; split on '/' to get bases.
        imports: list[tuple[str, str]] = []
        for tok in self._unit.replace("*", "/").split("/"):
            base = self._normalize_base(tok.strip())
            if not base:
                continue
            ns = self._unit_to_namespace(base)
            if (ns, base) not in imports:
                imports.append((ns, base))
        return imports

    def _collect_unit_imports(self) -> list[tuple[str, str]]:
        """Collect the union of unit imports this subtree references, walking
        descendants (issue #26, Option A).  Fail-loud: an unmapped unit base
        anywhere in the subtree raises NotImplemented (never a silent drop).
        """
        seen: list[tuple[str, str]] = []
        stack = [self]
        while stack:
            node = stack.pop()
            for imp in node._unit_imports():
                if imp not in seen:
                    seen.append(imp)
            stack.extend(c for c in node._children if c is not None)
        return seen

    @staticmethod
    def _normalize_base(base: str) -> str:
        """Normalize an astropy unit base-name token for map lookup.  Squared
        powers ('s2') are stripped to the base ('s'); a bare magnitude
        ('' from a number) yields '' (skipped)."""
        return base.rstrip("0123456789").strip()

    def _render_unit_imports(self, indent: str) -> str:
        """Render `public import <ns>::<unit>;` lines for this subtree's unit
        imports (issue #26, Option A), one per distinct (ns,unit)."""
        imps = self._collect_unit_imports()
        if not imps:
            return ""
        lines = [
            f"{indent}public import {ns}::{unit};" for (ns, unit) in imps
        ]
        return "\n".join(lines)

    # -- modifiers ------------------------------------------------------

{% for slot in usage_modifier_slots %}
    def _set_{{ slot.name }}(self, value=None):
        """Set the ``{{ slot.tokens|join(' ') }}`` modifier(s)."""
{% if slot.kind == 'flag' %}
        # W2-11: clear mutually-exclusive modifiers so e.g. abstract+variation
        # can never both render.
{% for t in slot.mex_tokens %}
        self._modifiers.pop("{{ t }}", None)
{% endfor %}
{% for t in slot.tokens %}
        self._modifiers["{{ t }}"] = True if value is None else value
{% endfor %}
{% else %}
        # enum: validate against the allowed tokens, key by slot NAME
        # (emission emits the bare value, W1-3 / r3 W2-12).
        if value not in ({% for t in slot.tokens %}"{{ t }}"{% if not loop.last %}, {% endif %}{% endfor %}):
            raise ValueError(
                "{{ slot.name }} must be one of {{ slot.tokens|join(', ') }}, got " + repr(value)
            )
        self._modifiers["{{ slot.name }}"] = value
{% endif %}
        return self
{% endfor %}

    # -- typing ---------------------------------------------------------

    def _set_typed_by(self, typed):
        if not isinstance(typed, Builder):
            raise TypeError("_set_typed_by expects a Builder")
        if self._is_definition:
            raise ValueError("A definition element cannot be typed.")
        self._typed_by = typed
        return self

    def _set_multiplicity(self, mult):
        """Set the multiplicity (r3 W2-14); e.g. ``_set_multiplicity("1..*")``.
        Accepted as ``[1..*]`` or bare ``1..*``; emitted in brackets."""
        m = mult if isinstance(mult, str) else str(mult)
        self._multiplicity = m.strip("[]")
        return self

    # -- children -------------------------------------------------------

    def _set_child(self, child):
        if not isinstance(child, Builder):
            raise TypeError("_set_child expects a Builder")
        self._children.append(child)
        return self

    def add(self, child):
        """Ergonomic alias for ``_set_child`` (issue #27) — append a child so
        nested composition dumps a full package: ``pkg.add(part)``."""
        return self._set_child(child)

    def is_legal_child(self, child):
        """Advisory child-kind legality (W1-5/r3 W1-4/r4 #1/r5 W1-1).

        ``child.kind`` must appear among this builder's owned-body's legal
        child kinds (children.json) when that body is a known key; otherwise
        conservatively True (r5 W1-1).  Usage builders own ``DefinitionBody``
        whose slot kinds are exactly the builder vocabulary.  Package bodies
        additionally accept ALL usage kinds (children.json ``PackageBody``
        only lists definitions, but a package legitimately contains
        `part`/`attribute`/etc. members — r4 #1), so the usage kinds from
        ``DefinitionBody`` are unioned in.  Bodies not present in
        children.json (e.g. ``RelationshipBody`` for Import) have no
        membership data → never reject.
        """
        body = self.owned_body
        if body is None:
            # owns no body at all (e.g. _DefaultReferenceBuilder) — reject all
            return False
        if body not in LEGAL_CHILDREN:
            return True  # no membership data for this body — never reject
        allowed = LEGAL_CHILDREN[body]
        if body == "PackageBody":
            allowed = set(allowed) | set(LEGAL_CHILDREN.get("DefinitionBody", ()))
        return child.kind in allowed

    def _get_child(self, featurechain):
        return _walk_chain(self, featurechain)

    # -- directed features ----------------------------------------------

    def add_directed_feature(self, direction, name=None, *, kind_name="DefaultReferenceUsage"):
        if direction not in ("in", "out", "inout"):
            raise ValueError(f"direction must be in/out/inout, got {direction!r}")
        cls = _BUILDER_BY_NAME.get(kind_name, _DefaultReferenceBuilder)
        feat = cls(name)
        feat._set_direction(direction)
        self._set_child(feat)
        return self

    def _get_grammar(self):
        return self.build_node()

    def build(self, dict_=True):
        d = self._to_ir()
        return d if dict_ else self.build_node()

    def build_node(self):
        return Node.from_ir(self._to_ir())

    def dump(self):
        from .ast_classes import beautify
        text = self._render_sysml()
        if text.strip():
            # Issue #26: inject the subtree-wide `public import <ns>::<unit>;`
            # lines into the ROOT body (Option A) — exactly once, after the
            # opening `{`.  A nested/member call to _render_sysml must NOT
            # emit them again, so the union is computed here from the whole
            # tree and inserted into the outermost dump only.
            imps = [i for i in self._collect_unit_imports() if i]
            if imps and "{" in text:
                # Inject bare import lines (no leading spaces): beautify adds
                # the brace-depth indent itself (3 spaces/level).
                import_lines = "\n".join(
                    f"public import {ns}::{unit};" for (ns, unit) in imps
                )
                text = text.replace("{", "{\n" + import_lines, 1)
            return beautify(text)
        return text

    def _render_sysml(self) -> str:
        """Render this builder subtree as textual SysML.

        Emits a ``KIND name`` header (modifiers upstream, short name as
        ``<s>``) and ``{ child ... }`` body braces.  Uses the coarse canonical
        IR kind + grammar modifier tokens (W1-3) so the header vocabulary
        matches ``parse_ir``.  ``;`` terminates childless statements (r3
        W1-8) so multi-member brace blocks recover as separate IR statements;
        ``/* */`` free text for Comment (r3 W1-7).
        """
        # r6: _set_text is Comment-only (raises otherwise, W2-1), so no
        # non-comment carry of _text through _render_sysml is needed.
        if self._text is not None and self._kind == "comment":
            # Comment payload is free text (r3 W1-7): self-terminating so
            # parse_ir yields a comment node rather than an unknown.
            return f"/* {self._text} */"

        # W2-10: emit modifiers in canonical slot order, not insertion order,
        # so e.g. `abstract` before ``out`` (valid RefPrefix) survives.
        mods: list[str] = []
        for _name, _tokens, _kind in _MODIFIER_SLOTS:
            # flags are stored by TOKEN ('abstract'), enums by NAME ('direction') —
            # r4 #2: look up by the correct key or slot-order emission never fires.
            key = _tokens[0] if _kind == "flag" else _name
            v = self._modifiers.get(key)
            if v is None or v is False:
                continue
            if v is True:
                mods.append(_tokens[0])
            elif isinstance(v, str):
                mods.append(v)  # enum — bare value (W1-3)
            else:
                mods.append(f"{_name}={v}")
        for k, v in self._modifiers.items():
            if any((s[2] == "flag" and k in s[1]) or (s[2] != "flag" and s[0] == k)
                   for s in _MODIFIER_SLOTS):
                continue
            if v is True:
                mods.append(k)
            elif isinstance(v, str):
                mods.append(v)
            elif v is not None and v is not False:
                mods.append(f"{k}={v}")
        mod_txt = (" ".join(mods) + " ") if mods else ""
        # Issue #27: `self._kind` is the coarse canonical-IR kind (part /
        # attribute / ...) OR the definition-variant keyword ("part def").
        # NEVER fall back to the class name (old `__class__.__name__
        # .replace("Builder","")` emitted `PartDefinition S;` for
        # kind='PartDefinition' — invalid SysML v2).  W1-3: print the
        # printable SysML keyword (`use case`, not the IR alias key
        # `use_case`).  Fall back to `self._kind` only so the base/default
        # path (which may not have set `_keyword` via __init__) still prints.
        keyword = getattr(self, "_keyword", None) or self._kind or self.ir_kind
        head = f"{mod_txt}{keyword}"
        if self._short_name is not None:
            head += f" <{self._short_name}>"  # r3 W1-5: angle (parse_ir vocab)
        if self._name is not None:
            head += f" {self._name}"
        if self._multiplicity is not None:
            head += f" [{self._multiplicity}]"
        if self._typed_by is not None:
            head += f" : {self._typed_by._name}"
        # Issue #26: value (and optional unit) — `attribute mass = 1000[kg];`
        # value+unit with NO space between them (corpus).  Plain string value
        # (no unit) renders `attribute mass = 1000;`.
        if self._value is not None:
            if self._unit:
                head += f" = {self._value}[{self._unit_bracket(self._unit)}]"
            else:
                head += f" = {self._value}"
        lines = [head]
        kids = [c for c in self._children if c is not None]
        # (rest unchanged) — indentation/termination follows
        if kids:
            lines.append("{")
            for c in kids:
                lines.append(c._render_sysml())
            lines.append("}")
        else:
            lines[0] = head + ";"  # r3 W1-8: terminate childless statements
        return "\n".join(lines)

    def _to_ir(self):
        d: dict[str, object] = {"kind": self._kind}
        if self._name is not None:
            d["name"] = self._name
        if self._short_name is not None:
            d["short_name"] = self._short_name
        if self._text is not None and self._kind == "comment":
            # r5 W2-3: text is only persisted to raw_text for Comment.  For
            # other kinds the text is rendered by _render_sysml (appended after
            # the header) but must NOT go into raw_text, or Node.dump() would
            # prefer raw_text and drop the header + glue the subtree.
            d["raw_text"] = self._text
        if self._multiplicity is not None:
            d["multiplicity"] = self._multiplicity
        if self._value is not None:
            d["value"] = self._value
            if self._unit:
                d["unit"] = self._unit
        mods: list[str] = []
        for _nm, _tk, _kd in _MODIFIER_SLOTS:
            key = _tk[0] if _kd == "flag" else _nm
            v = self._modifiers.get(key)
            if v is None or v is False:
                continue
            if v is True:
                mods.append(_tk[0])
            elif isinstance(v, str):
                mods.append(v)
            else:
                mods.append(f"{_nm}={v}")
        for k, v in self._modifiers.items():
            if any((s[2] == "flag" and k in s[1]) or (s[2] != "flag" and s[0] == k)
                   for s in _MODIFIER_SLOTS):
                continue
            if v is True:
                mods.append(k)
            elif isinstance(v, str):
                mods.append(v)
            elif v is not None and v is not False:
                mods.append(f"{k}={v}")
        if mods:
            d["modifiers"] = mods
        if self._typed_by is not None:
            # B1/W2-5: type_refs is the _NODE_IR_FIELDS key that carries the
            # typed reference (typed_by was never in the AST IR and would
            # throw).  Use the referent's _name to match the name IR field.
            d["type_refs"] = [self._typed_by._name]
        kids = [c for c in self._children if c is not None]
        if kids:
            d["children"] = [c._to_ir() for c in kids]
        return d


class _DefaultReferenceBuilder(Builder):
    kind = "DefaultReferenceUsage"
    ir_kind = "reference"
    owned_body = None


def _walk_chain(root, featurechain):
    """Resolve a dotted feature chain ('x.y.z') under ``root``.

    A leading self-name segment (matched against the root's effective name)
    is tolerated (0.5.3 _get_child behaviour) and skipped.
    """
    if not isinstance(featurechain, str):
        raise TypeError("featurechain must be a str")
    fc = featurechain.split(".")
    # r4 #7: match the root self-name against LONG or SHORT name (was
    # _get_name() which preferred short name, breaking long chains).
    if fc and fc[0] in (root._name, root._short_name):
        fc = fc[1:]
        if not fc:
            return root
    cur = root
    for seg in fc:
        found = None
        for child in cur._children:
            # W2-15 (r3): match the LONG name first, then the short name, so a
            # dotted chain keeps resolving even when a member has a short name.
            if child._name == seg or child._short_name == seg:
                found = child
                break
        if found is None:
            return None
        cur = found
    return cur


