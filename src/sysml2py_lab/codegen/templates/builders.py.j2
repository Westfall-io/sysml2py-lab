{{ header }}
"""Generated builder API for the sysml2py AST (issue #10, phase-5).

Deterministically generated by sysml2py-lab from:
  - spec/relationships/modifiers.json  (per-kind modifier setters)
  - spec/relationships/children.json   (child-kind legality per body)
  - IR_KIND_ALIASES / node kinds       (which builder classes to emit)

This is a SELF-CONTAINED, THIN builder: it targets the canonical IR dict
shape (the same shape ``ast_classes.Node.from_ir`` consumes), so a model
built through this API casts — ``build()`` -> ``Node`` -> ``dump()`` ->
parse back -> identical structure.  It deliberately does NOT require textX
or astropy at runtime (issue #10 dependency-posture decision: self-contained
thin; see the API-compat report for the 0.5.3 breaks this entails).
"""

from __future__ import annotations

from .ast_classes import Node

# ruff: noqa: RUF022  (generated __all__ ordering)

__all__ = [
    "Builder",
    "UPSERT_CHILD_KINDS",
    "LEGAL_CHILDREN",
{% for name in builder_class_names %}
    "{{ name }}",
{% endfor %}
]

# Which child kinds may live under each owning body (issue #10: _set_child
# must reject grammatically illegal children).  Indexed by the owning
# construct's owned-body name -> set of legal child node kinds, derived from
# children.json.
LEGAL_CHILDREN: dict[str, set[str]] = {
{% for body, kinds in legal_children.items() %}
    "{{ body }}": {
{% for k in kinds %}
        "{{ k }}",
{% endfor %}
    },
{% endfor %}
}

# The child kinds that define an upsert-by-name key (i.e. a named member).
UPSERT_CHILD_KINDS: set[str] = {"{{ named_kinds|join('", "') }}"}


class Builder:
    """Base builder: accumulates a canonical-IR dict sub-tree.

    A builder mirrors the issue-#8/#9 IR node shape
    (``{"kind", "name", "children", ...}``).  ``build()`` returns the dict,
    ``build_node()`` lifts it through ``Node.from_ir`` (so the cast closes),
    and ``dump()`` renders the textual SysML via the generated node.
    """

    kind = ""
    owned_body = None  # e.g. "UsageBody" — the body legal-child lookup uses it

    def __init__(self, name=None, *, kind=None):
        self._name = name
        self._short_name = None
        self._modifiers: dict[str, object] = {}
        self._typed_by = None
        self._is_definition = False
        self._kind = kind or self.kind
        self._children: list[Builder] = []
        self._definition = None

    # -- identity -------------------------------------------------------

    def _set_name(self, name, short=False):
        if short:
            self._short_name = name
        else:
            self._name = name
        return self

    def _get_name(self):
        return self._short_name or self._name

    def _set_short_name(self, name):
        self._short_name = name
        return self

    # -- modifiers ------------------------------------------------------

{% for slot in definition_modifier_slots %}
    def _set_{{ slot.name }}(self, value=None):
        """Set the ``{{ slot.tokens|join(' ') }}`` modifier(s)."""
{% if slot.kind == 'flag' %}
        self._modifiers["{{ slot.name }}"] = True if value is None else value
{% else %}
        self._modifiers["{{ slot.name }}"] = value
{% endif %}
        return self
{% endfor %}

    # -- typing ---------------------------------------------------------

    def _set_typed_by(self, typed):
        if not isinstance(typed, Builder):
            raise TypeError("_set_typed_by expects a Definition builder")
        if self._is_definition:
            raise ValueError("A definition element cannot be typed.")
        self._typed_by = typed
        return self

    # -- children -------------------------------------------------------

    def _set_child(self, child):
        if not isinstance(child, Builder):
            raise TypeError("_set_child expects a Builder")
        if self.owned_body is not None:
            legal = LEGAL_CHILDREN.get(self.owned_body, set())
            if legal and child.kind not in legal:
                raise ValueError(
                    f"{self.__class__.__name__} body {self.owned_body!r} does not "
                    f"permit a {child.kind!r} child (legal: {sorted(legal)})"
                )
        self._children.append(child)
        return self

    def _get_child(self, featurechain):
        return _walk_chain(self, featurechain)

    # -- directed features ----------------------------------------------

    def add_directed_feature(self, direction, name=None, *, kind_name="DefaultReferenceUsage"):
        if direction not in ("in", "out", "inout"):
            raise ValueError(f"direction must be in/out/inout, got {direction!r}")
        cls = _dir_feature_cls().get(kind_name, _DefaultReferenceBuilder)
        feat = cls(name)
        if hasattr(feat, "_set_direction"):
            feat._set_direction(direction)
        self._set_child(feat)
        return self

    def _get_grammar(self):
        return self.build_node()

    def build(self, dict_=True):
        d = self._to_ir()
        return d if dict_ else self.build_node()

    def build_node(self):
        return Node.from_ir(self._to_ir())

    def dump(self):
        from .ast_classes import beautify
        text = self._render_sysml()
        return beautify(text) if text.strip() else text

    def _render_sysml(self) -> str:
        """Render this builder subtree as grammatical SysML text.

        Emits a ``MODIFIERS KIND name`` header with an optional ``:>
        typed`` continuation and ``{ child ... }`` body braces — the shape
        the lab's ``parse_ir`` recovers (issue #10 syntactic-printer cast).
        """
        mods = [k for k, v in self._modifiers.items() if v is True]
        # value-modifiers render as keyword=value tokens
        for k, v in self._modifiers.items():
            if v is True:
                if k not in mods:
                    mods.append(k)
            elif v is None or v is False:
                continue
            else:
                mods.append(f"{k}={v}")
        mod_txt = (" ".join(mods) + " ") if mods else ""
        kind = self._kind or self.__class__.__name__.replace("Builder", "")
        head = f"{mod_txt}{kind}"
        if self._name is not None:
            head += f" {self._name}"
        if self._is_definition:
            head += " :> " + (self._name or "")
        lines = [head]
        kids = [c for c in self._children if c is not None]
        if kids:
            lines.append("{")
            for c in kids:
                lines.append(c._render_sysml())
            lines.append("}")
        return "\n".join(lines)

    def _to_ir(self):
        d: dict[str, object] = {"kind": self._kind}
        if self._name is not None:
            d["name"] = self._name
        if self._short_name is not None:
            d["short_name"] = self._short_name
        mods = [k for k, v in self._modifiers.items() if v]
        if mods:
            d["modifiers"] = mods
        kids = [c for c in self._children if c is not None]
        if kids:
            d["children"] = [c._to_ir() for c in kids]
        if self._typed_by is not None:
            d["typed_by"] = self._typed_by._to_ir()
        if self._definition is not None:
            d["definition"] = self._definition
        return d


class _DefaultReferenceBuilder(Builder):
    kind = "DefaultReferenceUsage"
    owned_body = None

    def _set_direction(self, direction):
        self._modifiers["direction"] = direction
        return self


def _walk_chain(root, featurechain):
    """Resolve a dotted feature chain ('x.y.z') under ``root``.

    Leading self-name segment is tolerated (0.5.3 _get_child behaviour):
    if the first segment equals the root's name it is skipped.
    """
    if isinstance(featurechain, str):
        fc = featurechain.split(".")
    else:
        raise TypeError("featurechain must be a str")
    if fc and self_partial_name(root) == fc[0]:
        fc = fc[1:]
        if not fc:
            return root
    cur = root
    for seg in fc:
        found = None
        for child in (cur._children if isinstance(cur, Builder) else ()):
            if child._get_name() == seg:
                found = child
                break
        if found is None:
            return None
        cur = found
    return cur


def self_partial_name(b):
    return b._name if isinstance(b, Builder) else None


