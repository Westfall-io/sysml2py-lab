"""Generated membership-dispatch table (issue #9).

Derived from ``spec/relationships/children.json`` — replaces the hand-written
``elif`` ladders in the 266-class ``classes.py`` (DefinitionElement had a
16-branch ladder; DefinitionBodyItem/PackageBody/UsageElement more).

``dispatch_member(parent_body, member_kind)`` returns the class handling
``member_kind`` inside ``parent_body`` (a children.json BODY key, not a
class name), or ``Unsupported`` (never raises).
"""

from __future__ import annotations

from typing import Any

from . import ast_classes
from .ast_classes import Unsupported

# IR-kind (coarse brace-block token) -> generated class name.  The issue-#7 IR
# produces kinds like "package"/"part"; the generated classes are fine-grained
# grammar classes.  This alias lifts IR nodes onto generated classes.
IR_KIND_ALIASES: dict[str, str] = {
{% for ir_kind, cls in ir_kind_aliases.items() %}
    "{{ ir_kind }}": "{{ cls }}",
{% endfor %}
}

# {parent_body: {member_kind: child_class_name}}
MEMBERSHIP_DISPATCH: dict[str, dict[str, str]] = {
{% for body, table in dispatch_map.items() %}
    "{{ body }}": {
{% for member_kind, child in table.items() %}
        "{{ member_kind }}": "{{ child }}",
{% endfor %}
    },
{% endfor %}
}

# {parent_class_name: owned_body} — the body a construct CONTAINS (derived
# from the grammar rule's own body reference, following fragments).  Lets
# from_ir dispatch children under the correct body context:
#   Package -> PackageBody, PartDefinition/PartUsage -> DefinitionBody/UsageBody
CLASS_TO_BODY: dict[str, str] = {
{% for cls_name, body in class_to_body.items() %}
    "{{ cls_name }}": "{{ body }}",
{% endfor %}
}


def _resolve_kind(kind: str) -> str:
    """Map an IR kind (lowercase token) to a generated class name."""
    if kind in IR_KIND_ALIASES:
        return IR_KIND_ALIASES[kind]
    return kind


def dispatch_member(parent_body: str, member_kind: str) -> type:
    """Return the class handling ``member_kind`` inside ``parent_body``.

    ``parent_body`` is a children.json BODY key (``PackageBody``,
    ``DefinitionBody``, ...), NOT a class name.  ``member_kind`` may be an IR
    coarse kind (lowercase, e.g. ``package``) or a generated class name.
    Falls back to ``Unsupported`` (which carries raw text) rather than
    raising — the grammar may allow a member that has no modelled class yet.
    """
    cls_name = _resolve_kind(member_kind)
    table = MEMBERSHIP_DISPATCH.get(parent_body, {})
    child = table.get(cls_name) or table.get(member_kind)
    if child is None:
        return Unsupported
    return getattr(ast_classes, child, Unsupported)


def dispatch_children(parent_body: str, children: list[dict]) -> list[Any]:
    """Dispatch a list of IR child dicts to generated node instances.

    Each child with a ``kind`` is dispatched via ``dispatch_member``; unknown
    kinds become ``Unsupported`` preserving ``raw_text``.
    """
    out: list[Any] = []
    for c in children:
        kind = c.get("kind", "")
        cls = dispatch_member(parent_body, kind)
        if cls is Unsupported:
            out.append(Unsupported(raw_text=c.get("raw_text")))
        elif hasattr(cls, "from_ir"):
            out.append(cls.from_ir(c))
        else:
            out.append(Unsupported(raw_text=c.get("raw_text")))
    return out
