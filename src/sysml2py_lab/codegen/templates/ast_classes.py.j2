"""Generated AST node classes (issue #9).

Deterministically generated by sysml2py-lab from:
  - spec/language_spec.json (rule bodies)
  - spec/relationships/children.json → ast_dispatch.py only (membership table)
  - corpus/manifest.json (provenance stamp)
  - IR_KIND_ALIASES (module constant, hand-maintained in codegen/model.py)

This file's class set is derived from grammar rules + EXTRA_KINDS;
modifiers.json does not shape any generated byte here (see the decision
record).  Do not edit by hand; regenerate with `sysml2py-lab generate`.

Two input modes are supported:

- **IR mode** — a dict produced by the lab's canonical IR
  (``sysml2py_lab.ir.ir_to_json``): ``{"kind": ..., "name": ...,
  "modifiers": [...], "raw_text": ..., "children": [...]}``.  ``dump()``
  returns ``raw_text`` verbatim (loss-minimizing: nothing is discarded).
- **textX mode** — a legacy 0.5.3 dict (``{"name": <RuleName>, ...}``) as
  produced by ``textX`` parsing and consumed by the hand-written classes.
  ``dump()`` reconstructs syntax from keyword/definition/prefix slots.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import ClassVar

# IR coarse-kind -> generated class-name alias (embedded; the standalone
# generated package cannot import from sysml2py_lab).
IR_KIND_ALIASES: dict[str, str] = {
{% for ir_kind, cls in ir_kind_aliases.items() %}
    "{{ ir_kind }}": "{{ cls }}",
{% endfor %}
}


def valid_definition(definition, name):
    """Check a textX-style definition dict matches the expected node name.

    Preserved from the 0.5.3 hand-written classes contract so
    ``formatting.reformat`` output keeps working.
    """
    if isinstance(definition, dict):
        if "name" in definition:
            if definition["name"] == name:
                return True
            raise ValueError(
                "The name of the element did not match."
            )
        raise AttributeError("This does not seem to be valid.")
    raise TypeError("This does not seem to be valid.")


def beautify(string):
    """Indent a multi-line SysML string by brace depth (0.5.3 compat)."""
    level = 0
    lines = string.split("\n")
    ns = []
    for line in lines:
        line = line.rstrip()
        if line == "}":
            level += -1
        ns.append(level * "   " + line)
        if len(line) > 0 and line[-1] == "{":
            level += 1
    return "\n".join(ns)


def _terminate_line_comment(raw: str) -> str:
    """Ensure a ``//`` line-comment raw_text ends with a newline.

    The canonical tokenizer treats ``//`` as consuming to end-of-line, so a
    comment joined with no trailing newline would swallow every following
    sibling (the issue-#8 render_ir lesson).
    """
    if raw.lstrip().startswith("//") and not raw.endswith("\n"):
        return raw + "\n"
    return raw


class Unsupported:
    """Loss-minimizing node for grammar constructs with no modelled class.

    Carries the raw source text so nothing is silently discarded (issue #9:
    zero ``NotImplementedError`` — unsupported constructs are preserved, not
    raised).  Mirrors Node's field surface so ``Node.from_ir`` can construct
    it with the same kwargs.
    """

    def __init__(
        self,
        definition=None,
        *,
        raw_text=None,
        kind=None,
        name="",
        short_name="",
        modifiers=None,
        type_refs=None,
        multiplicity=None,
        children=None,
        source_span=(0, 0),
        fidelity="modelled",
        ir_kind=None,
    ):
        self.definition = definition
        self.raw_text = raw_text
        self.kind = kind
        self.ir_kind = ir_kind
        self.name = name
        self.short_name = short_name
        self.modifiers = list(modifiers or [])
        self.type_refs = list(type_refs or [])
        self.multiplicity = multiplicity
        self.children = list(children or [])
        self.source_span = tuple(source_span)
        self.fidelity = fidelity

    def dump(self) -> str:
        out: list[str] = []
        if self.raw_text is not None:
            out.append(_terminate_line_comment(self.raw_text))
        elif isinstance(self.definition, dict):
            out.append(self.definition.get("raw_text", ""))
        for c in self.children:
            d = c.dump()
            if d:
                out.append(d)
        return "".join(out)

    def get_definition(self):
        if isinstance(self.definition, dict):
            out = dict(self.definition)
            out.setdefault("name", self.kind or "Unsupported")
            if self.raw_text is not None:
                out["raw_text"] = self.raw_text
            if self.children:
                out["children"] = [c.get_definition() for c in self.children]
            return out
        return {
            "kind": self.ir_kind or self.kind or "Unsupported",
            "name": self.name,
            "short_name": self.short_name,
            "modifiers": list(self.modifiers),
            "type_refs": list(self.type_refs),
            "multiplicity": self.multiplicity,
            "source_span": list(self.source_span),
            "raw_text": self.raw_text if self.raw_text is not None else "",
            "fidelity": self.fidelity,
            "children": [c.get_definition() for c in self.children],
        }

    @classmethod
    def from_ir(cls, d: dict) -> Unsupported:
        """Construct an Unsupported node from an IR JSON dict (loss-minimizing).

        Children are re-dispatched through ``Node.from_ir`` so a collapse to
        Unsupported at one level does NOT swallow descendants (review W2):
        an anonymous ``block`` gets its own raw_text, but any child that is a
        modelled kind still lifts to its generated class.
        """
        return cls(
            kind=d.get("kind", ""),
            ir_kind=d.get("kind", ""),
            name=d.get("name", ""),
            short_name=d.get("short_name", ""),
            raw_text=d.get("raw_text"),
            modifiers=list(d.get("modifiers", [])),
            type_refs=list(d.get("type_refs", [])),
            multiplicity=d.get("multiplicity"),
            children=[Node.from_ir(c) for c in d.get("children", [])],
            source_span=tuple(d.get("source_span", (0, 0))),
            fidelity=d.get("fidelity", "unsupported"),
        )


@dataclass
class Node:
    """Common IR-backed node base (loss-minimizing)."""

    kind: str = ""
    name: str = ""
    short_name: str = ""
    modifiers: list[str] = field(default_factory=list)
    type_refs: list[str] = field(default_factory=list)
    multiplicity: str | None = None
    children: list[Node] = field(default_factory=list)
    source_span: tuple[int, int] = (0, 0)
    raw_text: str = ""
    fidelity: str = "modelled"
    ir_kind: str | None = None  # IR coarse kind before alias lifting (W3)

    @classmethod
    def from_ir(cls, d: dict) -> Node:
        """Build a Node (or generated subclass) from an IR JSON dict.

        The IR's coarse kinds (``package``, ``part``, ...) are lifted to the
        generated subclasses via ``IR_KIND_ALIASES`` + ``KIND_REGISTRY`` (the
        registry is authoritative).  Children are recursively lifted the same
        way; an anonymous/opaque kind (``block``, ``brace_open``, ``unknown``)
        becomes ``Unsupported`` which still re-lifts any modelled descendant,
        so nothing is swallowed.  A coarse kind that aliases to a modelled
        class is never silently dropped: if its class is absent the node falls
        to ``Unsupported`` and the cast's ``unsupported_for_aliased`` check
        flags it.
        """
        kind = d.get("kind", "")
        cls_name = IR_KIND_ALIASES.get(kind, kind)
        node_cls = KIND_REGISTRY.get(cls_name, Unsupported)
        # r8 N2: route the Unsupported case through its own lossless
        # constructor so there is ONE payload path (short_name, children,
        # fidelity default all come from Unsupported.from_ir).  Prevents the
        # divergence where a top-level Unsupported got fidelity="modelled"
        # while a child one got fidelity="unsupported".
        if node_cls is Unsupported:
            return Unsupported.from_ir(d)
        children: list[Node] = []
        for c in d.get("children", []):
            child_cls_name = IR_KIND_ALIASES.get(c.get("kind", ""), c.get("kind", ""))
            child_cls = KIND_REGISTRY.get(child_cls_name, Unsupported)
            children.append(child_cls.from_ir(c))
        result = node_cls(
            kind=kind,
            name=d.get("name", ""),
            short_name=d.get("short_name", ""),
            modifiers=list(d.get("modifiers", [])),
            type_refs=list(d.get("type_refs", [])),
            multiplicity=d.get("multiplicity"),
            children=children,
            source_span=tuple(d.get("source_span", (0, 0))),
            raw_text=d.get("raw_text", ""),
            fidelity=d.get("fidelity", "modelled"),
            ir_kind=kind,
        )
        return result

    def dump(self) -> str:
        """Emit this node as SysML text (loss-minimizing).

        Prefers the node's own ``raw_text`` verbatim, then recurses into
        children (also dump()-ing their raw_text and descendants) — so a
        full IR tree reconstructs the source in order.  A ``//`` line-comment
        raw_text must be newline-terminated or the canonical tokenizer would
        swallow every following token (the issue-#8 render_ir lesson).
        """
        out: list[str] = []
        if self.raw_text:
            out.append(_terminate_line_comment(self.raw_text))
        else:
            parts: list[str] = []
            parts.extend(self.modifiers)
            if self.ir_kind or self.kind:
                head = self.ir_kind or self.kind
                if self.name:
                    parts.append(f"{head} {self.name}")
                elif "{" in head or head in ("brace_open", "brace_close"):
                    parts.append(head)
                # else: a bare kind with no name is not meaningful text
                # (e.g. the IR "root" node) — emit nothing rather than
                # malformed SysML.
            elif self.name:
                parts.append(self.name)
            if self.multiplicity:
                parts.append(self.multiplicity)
            if parts:
                out.append(" ".join(parts))
        for c in self.children:
            d = c.dump()
            if d:
                out.append(d)
        return "".join(out)

    def get_definition(self) -> dict:
        """Serialize back to an IR-JSON dict (preserving the IR coarse kind)."""
        return {
            "kind": self.ir_kind or self.kind,
            "name": self.name,
            "short_name": self.short_name,
            "modifiers": list(self.modifiers),
            "type_refs": list(self.type_refs),
            "multiplicity": self.multiplicity,
            "source_span": list(self.source_span),
            "raw_text": self.raw_text,
            "fidelity": self.fidelity,
            "children": [c.get_definition() for c in self.children],
        }


{% for kind in node_kinds %}
class {{ kind.name }}(Node):
    """Generated AST node for grammar rule ``{{ kind.name }}``."""

    _kind: ClassVar[str] = "{{ kind.name }}"

    def __init__(self, definition=None, *, raw_text=None, **kwargs):
        if definition is None:
            # IR/plain construction
            super().__init__(**kwargs)
            if raw_text is not None:
                self.raw_text = raw_text
            self.kind = "{{ kind.name }}"
        elif isinstance(definition, dict) and "kind" in definition:
            # IR-JSON dict
            ir_kind = definition.get("kind") or "{{ kind.name }}"
            # children arrive as IR dicts; lift them into generated nodes via
            # registry-authoritative Node.from_ir (IR_KIND_ALIASES ->
            # KIND_REGISTRY), rather than leaving raw dicts that dump()/
            # get_definition() would break on.
            kid_dicts = definition.get("children") or []
            kids = [
                Node.from_ir(c) if isinstance(c, dict) else c
                for c in kid_dicts
            ]
            super().__init__(
                **{k: v for k, v in definition.items() if k != "kind" and k != "children"},
                children=kids,
            )
            self.kind = ir_kind
            self.ir_kind = ir_kind
            if raw_text is not None:
                self.raw_text = raw_text
        else:
            # textX-mode dict
            valid_definition(definition, "{{ kind.name }}")
            super().__init__()
            self.kind = "{{ kind.name }}"
            self._definition = definition
            self.raw_text = raw_text

    def dump(self) -> str:
        if getattr(self, "_definition", None) is not None:
            return _dump_textx(self._definition)
        return Node.dump(self)

    def get_definition(self):
        if getattr(self, "_definition", None) is not None:
            out = dict(self._definition)
            out["name"] = "{{ kind.name }}"
            return out
        return super().get_definition()


