# Registry: IR kind -> generated class (built from the node_kinds list).
KIND_REGISTRY = {
{% for kind in node_kinds %}
    "{{ kind.name }}": {{ kind.name }},
{% endfor %}
}


def _dump_textx(definition: dict) -> str:
    """Reconstruct SysML syntax from a textX-mode dict.

    Handles the common 0.5.3 dict shape: optional prefix, keyword, name,
    definition/body, ownedRelationship members.  Unknown slots are preserved
    via raw_text/Unsupported rather than raising.
    """
    parts: list[str] = []
    if "prefix" in definition and definition["prefix"] is not None:
        pv = definition["prefix"]
        if isinstance(pv, dict):
            parts.append(_dump_textx(pv))
        else:
            parts.append(str(pv))
    if "keyword" in definition and definition["keyword"]:
        parts.append(str(definition["keyword"]))
    if "name" in definition and definition["name"] and \
            definition["name"] not in _SKIP_NAME_TOKENS:
        parts.append(str(definition["name"]))
    if "definition" in definition and definition["definition"] is not None:
        dv = definition["definition"]
        if isinstance(dv, dict):
            parts.append(_dump_textx(dv))
        elif isinstance(dv, list):
            parts.extend(_dump_textx(x) for x in dv if isinstance(x, dict))
        else:
            parts.append(str(dv))
    if "ownedRelationship" in definition and isinstance(definition["ownedRelationship"], list):
        for m in definition["ownedRelationship"]:
            parts.append(_dump_textx(m) if isinstance(m, dict) else str(m))
    if "ownedRelatedElement" in definition and isinstance(definition["ownedRelatedElement"], dict):
        parts.append(_dump_textx(definition["ownedRelatedElement"]))
    return " ".join(p for p in parts if p)


# Names that are structural (never emitted as a bare token by _dump_textx).
_SKIP_NAME_TOKENS = frozenset()
